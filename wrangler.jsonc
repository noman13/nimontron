{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The site address becomes https://<name>.<your-subdomain>.workers.dev
  "name": "biyer",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
